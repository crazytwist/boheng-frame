# =============================================================================
# boheng 预发环境配置模板
# 复制为 .env 后按实际情况填写，deploy.sh / init-db.sh 会读取本文件
# =============================================================================

# ------------------------- 目标服务器（大兴预发环境）SSH 连接 -------------------------
# HexHub「大兴预发」对应的主机信息，填这里脚本才能 ssh 过去部署
SSH_HOST=123.59.127.6
SSH_PORT=32222
SSH_USER=root
# 认证二选一：优先用密钥，没有密钥再填密码（明文，注意保密）
SSH_KEY=
SSH_PASSWORD=

# 目标服务器上的部署目录（脚本会把 compose + 镜像 tar 传到这里）
REMOTE_DIR=/opt/boheng

# ------------------------- 端口（28 段公网端口，可留空用默认值） -------------------------
# boheng.web    前端入口      默认 28081 （公网入口，仅这一个公开）
# boheng.server 后端 API      默认 28088 （内部反代，公网不开；调试可解开 docker-compose.yml 注释）
# boheng.mysql  数据库        默认 28086 （内部访问，公网不开）
# boheng.redis  缓存          默认 28082 （内部访问，公网不开）
PORT_WEB=28081
PORT_SERVER=28088
PORT_MYSQL=28086
PORT_REDIS=28082

# ------------------------- 中间件 -------------------------
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=boheng@2026
